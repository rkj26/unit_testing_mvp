.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage

# pipeline run outputs. Committed as of 2026-10-06 so a run is shareable and others can add their
# own: a run directory is config.json + records.jsonl, and nothing else is needed to read it.
#
# Three rules if you add one.
#   - Never commit a run that is still writing. `records.jsonl` is appended line by line and a
#     mid-write commit captures a torn final record.
#   - Check the size. GitHub refuses any single file over 100 MB. A 2,776-candidate suite arm is
#     81 MB and a two-call arm projects past 290 MB, so the big ones must be gzipped to
#     `records.jsonl.gz` first — `load_records` reads either form, preferring the plain one.
#   - `console.log` is the tmux transcript, not an artifact. It is ignored below.
runs/*/console.log
reports/multi_turn_smoke_audit/**/console.log

# post-hoc rescorings of a completed run (reaggregate.py) — reproducible from runs/, don't commit
reaggregations/

# full APPS pools (32-52 MB each), rebuildable with prepare_candidate_pool.py.
# apps_pool_hard10.json and apps_pool_random50.json are kept: they are small and published
# numbers use them. A new pool goes in this list in the diff that creates it.
apps_pool_hard.json
apps_pool_heldout40.json
apps_pool_uniform400.json
apps_pool_full.json

# archives of runs/, which is itself ignored
*.zip

# BigCodeBench task byproducts written into CWD during local execution
split_*
*.db
test_images_*/
mnt/
output/
*.log
df_contents.txt
names.csv
country_population_report.csv
s0.txt
s1.txt
papers/*.pdf

# generated by sphinx from the docstrings; rebuild with `sphinx-build docs docs/_build/html`
docs/_build/
.ipynb_checkpoints/

.DS_Store
.claude/

# Obsidian vault config
.obsidian/

# throwaway analysis scripts; anything worth keeping becomes a notebook cell
scratch/

# superseded artifacts kept for the paired before/after comparison, not for reuse
archived/

# progress notes for a human, not part of the repo
progress_report.md
