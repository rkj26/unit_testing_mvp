FROM python:3.12-slim

ENV MPLBACKEND=Agg \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

RUN pip install --no-cache-dir \
        numpy==2.3.5 \
        pandas==2.3.3 \
        matplotlib==3.11.1 \
        scikit-learn==1.7.2 \
        scipy==1.16.3 \
        seaborn==0.13.2 \
        statsmodels==0.14.6 \
        regex==2026.7.19 \
        cryptography==46.0.3 \
        pytz==2026.3 \
        python-dateutil==2.9.0.post0 \
        flask==3.1.3 \
        pillow==12.3.0 \
        requests==2.34.2 \
        beautifulsoup4==4.15.0 \
        nltk==3.9.2 \
        faker==38.2.0 \
        openpyxl==3.1.5 \
        texttable==1.7.0 \
        pycryptodome==3.23.0 \
    && python -c "import pandas, numpy, matplotlib, sklearn, scipy, seaborn, statsmodels"
