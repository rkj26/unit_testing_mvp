# Copy to .env and fill in your values. .env is gitignored — never commit real keys.

# --- Trusted model: Azure AI Foundry ---------------------------------------
# Used when you pass --model azureai/<deployment> (property-gen, trigger-search, TM, informed-TM).
# The base URL looks like https://<your-resource>.services.ai.azure.com/models
AZUREAI_BASE_URL=https://<your-resource>.services.ai.azure.com/models
AZUREAI_API_KEY=<your-azure-key>

# Example runs:
#   .venv/bin/python run.py --domain apps --pool apps_pool_hard.json --model azureai/DeepSeek-V3.2 --runs 5
#   .venv/bin/python run.py --domain bcb  --pool candidate_pool_hard50.json --model azureai/<gpt-deployment>
#   .venv/bin/python run.py --domain mock --mock            # offline smoke, no keys needed

# --- Optional: other inspect_ai providers (only if you use them) ------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
