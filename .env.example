# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — NEVER put real keys in `.env.example` (this file is committed).

# =============================================================================
# Trusted model — Azure AI Foundry via its OpenAI-compatible endpoint
# =============================================================================
# Azure Foundry gives you an OpenAI-compatible endpoint ending in /openai/v1, used with the
# openai SDK. inspect_ai reaches it via the `openai-api` provider; the service prefix `azureai`
# in the model string tells it to read the two vars below.
#
# REQUIRED: the OpenAI-compatible endpoint (note the /openai/v1 suffix):
AZUREAI_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1

# REQUIRED: your API key (Foundry -> your resource -> Keys). Key auth works; you do NOT need the
# Entra-ID token_provider that some Azure snippets show.
AZUREAI_API_KEY=<your-azure-key>

# =============================================================================
# Which model to run  (pass on the CLI, not here)
# =============================================================================
# Format: --model openai-api/azureai/<deployment-name>   (deployment name is case-sensitive,
# exactly as it appears in Foundry, e.g. DeepSeek-V3.2).
#
#   .venv/bin/python run.py --domain apps --pool apps_pool_hard.json \
#       --model openai-api/azureai/DeepSeek-V3.2 --runs 5
#   .venv/bin/python run.py --domain bcb  --pool candidate_pool_hard50.json \
#       --model openai-api/azureai/<your-gpt-deployment>
#   .venv/bin/python run.py --domain mock --mock          # offline smoke, no keys needed
#
# (No azure-ai-inference package needed — this route uses the openai SDK that ships with inspect_ai.)

# =============================================================================
# Optional: other inspect_ai providers (only if you point --model at them)
# =============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
