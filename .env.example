# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — NEVER put real keys in `.env.example` (this file is committed).
#
# One-time install (the inspect_ai azureai provider needs the Azure SDK):
#   .venv/bin/pip install azure-ai-inference azure-core

# =============================================================================
# Trusted model — Azure AI Foundry (used by --model azureai/<deployment>)
# =============================================================================
# REQUIRED: your Foundry inference endpoint. Format (note the trailing /models):
#   https://<your-resource>.services.ai.azure.com/models
AZUREAI_BASE_URL=https://<your-resource>.services.ai.azure.com/models

# REQUIRED: the API key for that endpoint (Foundry → your resource → Keys).
AZUREAI_API_KEY=<your-azure-key>

# inspect_ai also accepts these as fallbacks (set only if you use them instead):
#   AZUREAI_ENDPOINT_URL=<same as AZUREAI_BASE_URL>
#   AZURE_API_KEY=<same key>            # legacy name, also honored

# =============================================================================
# Which model to run  (pass on the CLI, not here)
# =============================================================================
# The string after `azureai/` MUST match the DEPLOYMENT NAME in your Foundry
# project exactly (case-sensitive). Your two models, as examples:
#
#   DeepSeek 3.2 :  --model azureai/<your-deepseek-3.2-deployment-name>
#   GPT 5.4      :  --model azureai/<your-gpt-5.4-deployment-name>
#
# Full example runs:
#   .venv/bin/python run.py --domain apps --pool apps_pool_hard.json \
#       --model azureai/<deepseek-deployment> --runs 5
#   .venv/bin/python run.py --domain bcb  --pool candidate_pool_hard50.json \
#       --model azureai/<gpt-deployment>
#   .venv/bin/python run.py --domain mock --mock          # offline smoke, no keys needed

# =============================================================================
# Optional: other inspect_ai providers (only if you point --model at them)
# =============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
